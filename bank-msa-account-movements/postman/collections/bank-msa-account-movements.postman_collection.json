              "raw": "{{baseUrl}}/api/clientes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes"]
            }
          }
        },
        {
          "name": "GET Obtener cliente por ID",
          "request": {
            "method": "GET",
            "header": [],
