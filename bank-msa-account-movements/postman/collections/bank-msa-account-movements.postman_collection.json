          "name": "GET Generar reporte de movimientos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reportes?clienteId={{clienteId}}&inicio=2024-01-01&fin=2024-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reportes"],
              "query": [
                {
                  "key": "clienteId",
                  "value": "{{clienteId}}"
                },
                {
                  "key": "inicio",
                  "value": "2024-01-01"
                },
