            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"genero\": \"Masculino\",\n  \"edad\": 30,\n  \"identificacion\": \"1234567890\",\n  \"direccion\": \"Av. Siempre Viva 123\",\n  \"telefono\": \"0991234567\",\n  \"password\": \"password123\",\n  \"estado\": true\n}",
              "options": {
